---
/**
 * /signin -- the Google Messages sign-in helper, from the Figma frames
 * "dumb.co/signin (firefox)", "(not firefox)" and "(mobile)" in dumb product
 * design > onboarding (post user testing).
 *
 * Google blocks Google-account login inside embedded webviews, so the flip
 * phone can't sign itself in. Instead a desktop Firefox extension signs in
 * inside a private window, reads that window's session cookies and shows a
 * QR the Dumb Down app scans. Private windows are required: Google rotates
 * the session cookie ~every 30 min and only one holder can rotate it, so a
 * login taken from the everyday profile gets the flip phone signed out soon
 * after. Firefox on a computer only.
 *
 * Plain HTML and CSS, no React: the page is also opened on the flip phone
 * itself, whose browser is small, old and driven by a D-pad. The markup
 * arrives showing "visit this page on a firefox browser", which is right for
 * every browser but desktop Firefox; a few lines of ES5 in <head> switch to
 * the steps there before the first paint, so there is no flash. Mobile-first
 * CSS without flex gap or grid, which the phone's engine may not have.
 * Step 1's picture is a screen recording that only desktop Firefox loads
 * (the script at the end of <body>).
 */
import Analytics from "./Analytics.astro";
import { webp, webpSet } from "./lib/assets";
import fontsCss from "../../public/fonts.css?raw";
import cheltenham from "./assets/fonts/cheltenham-bold-extra-condensed.otf?url";

import logo from "./assets/signin/logo-white.png";
import phones from "./assets/signin/phones.png";
import laptop from "./assets/signin/laptop.svg";
import arrow from "./assets/signin/arrow.svg";
import step1 from "./assets/signin/step1.png";
import step2 from "./assets/signin/step2.png";
import step3 from "./assets/signin/step3.png";
/* step 1's screen recording, silent, cut down from the 2720x1530 original:
   VP9 WebM first, which every desktop Firefox plays (Linux ones without
   H.264 too), H.264 MP4 as the fallback. ?url: copied and hashed as they
   are. Re-make them from the original with:
     ffmpeg -i in.mp4 -an -vf scale=1280:-2:flags=lanczos -pix_fmt yuv420p -c:v libvpx-vp9 -b:v 0 -crf 38 -row-mt 1 -tile-columns 1 -g 150 -pass 1 -passlogfile /tmp/step1 -f null /dev/null
     ffmpeg -i in.mp4 -an -vf scale=1280:-2:flags=lanczos -pix_fmt yuv420p -c:v libvpx-vp9 -b:v 0 -crf 38 -row-mt 1 -tile-columns 1 -g 150 -pass 2 -passlogfile /tmp/step1 -map_metadata -1 step1.webm
     ffmpeg -i in.mp4 -an -vf scale=1280:-2:flags=lanczos -pix_fmt yuv420p -c:v libx264 -preset slow -crf 25 -level 4.0 -map_metadata -1 -movflags +faststart step1.mp4 */
import step1Webm from "./assets/signin/step1.webm?url";
import step1Mp4 from "./assets/signin/step1.mp4?url";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const canonical = new URL("signin", new URL(base, Astro.site ?? "https://dumb.co")).href;
const fontFaces = fontsCss.replace(/\/\*[\s\S]*?\*\//g, "").replace(/url\("fonts\//g, `url("${base}fonts/`).trim();
const cheltenhamFace = `@font-face{font-family:"Cheltenham";src:url("${cheltenham}") format("opentype");font-weight:700;font-style:normal;font-display:swap;}`;

/* Mozilla-signed .xpi, self-hosted (public/downloads/). Firefox installs it
   from any HTTPS origin because Mozilla signed it. */
const XPI_URL = "https://dumb.co/downloads/dumb-down-login-1.5.8.xpi";
const FIREFOX_URL = "https://www.mozilla.org/firefox/new/";

const img = {
  logo: await webp(logo, { width: 280 }),
  phones: await webp(phones, { width: 1067 }),
  steps: await Promise.all([step1, step2, step3].map((s) => webpSet(s, [480, 800, 1200]))),
};
const STEP_SIZES = "(min-width: 1000px) 33vw, 100vw";

const steps = [
  { h: "1. add our extension to ur browser",
    p: "make sure to press “Allow extension to run in private windows” and to pin the extension to ur toolbar",
    button: true, framed: false, video: { webm: step1Webm, mp4: step1Mp4 } },
  { h: "2. click extension to signin",
    p: "scan the qr code and follow google’s guidance. u’ll be asked to signin with the email u use for google messages. the qr code will be shown for 30 seconds only, after which you will have to sign in again.",
    button: false, framed: true },
  { h: "3. enjoy chatting on ur dumbphone :)",
    p: "make sure to press “Allow extension to run in private windows” and to pin the extension to ur toolbar",
    button: false, framed: true },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign in - dumb.co</title>
  <meta name="description" content="Sign in to Google Messages on your dumbphone with the dumb.co Firefox extension." />
  <link rel="canonical" href={canonical} />
  {base !== "/" && <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content="#0f0f0f" />
  <link rel="icon" type="image/png" href={`${base}favicon.png`} />
  <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
  <!-- desktop Firefox only: phones (incl. KaiOS, which says Firefox) and
       Seamonkey can't run the extension -->
  <script is:inline>
    (function () {
      var ua = navigator.userAgent;
      if (/Firefox\//.test(ua) && !/Seamonkey\/|Android|iPhone|iPad|iPod|Mobile|KAIOS/i.test(ua)) {
        document.documentElement.className += " ff";
      }
      // iPhones only show :active (the button's pressed state) on a page
      // that listens for touches
      document.addEventListener("touchstart", function () {}, { passive: true });
    })();
  </script>
  <style set:html={fontFaces + cheltenhamFace}></style>
  <!-- inline, so it ships exactly as written: the build's CSS minifier would
       turn max-width queries into (width<=360px) and the state colours into
       8-digit hex, which the flip phone's old Chromium can't read -->
  <style is:inline>
    /* tokens from the dumb design system, as the frames use them */
    :root{
      --bg:#0f0f0f;
      --text-strong:#fafaf0;
      --text-weak:#b4b4ad;
      --brand:#faf594;
      --on-brand:#14140c;
      --state-hovered:rgba(15,15,15,.05);   /* primary/interaction/hovered */
      --state-pressed:rgba(15,15,15,.1);    /* primary/interaction/pressed */
      --headline:"Cheltenham", Georgia, serif;
      --body:"Helvetica Now Display", "Helvetica Neue", Helvetica, Arial, sans-serif;
    }
    html,body{margin:0; padding:0; background:var(--bg); color:var(--text-strong);}
    body{font-family:var(--body); font-weight:500; -webkit-text-size-adjust:100%;}
    img{max-width:100%; height:auto; border:0;}
    h1,h2,p,ol{margin:0;}

    .logo{position:absolute; left:31px; top:32px; display:block; width:71px; line-height:0;}
    .logo img{width:100%;}

    /* which state shows */
    .steps{display:none;}
    .ff .get-ff{display:none;}
    .ff .steps{display:block;}
    .art-phones{display:none;}

    /* the button (Figma: dumb design system > button, hierarchy=primary,
       appearance=variable): device=smart here, device=dumb in the flip-phone
       block. Hovered and pressed lay a dark layer over the brand fill, as the
       component does. */
    .btn{
      display:inline-flex; align-items:center; justify-content:center;
      background-color:var(--brand); color:var(--on-brand);
      border-radius:96px; padding:12px 16px 16px; text-decoration:none;
      font-family:var(--body); font-weight:800; font-size:20px; line-height:1.4;
      text-transform:lowercase; white-space:nowrap;
      -webkit-tap-highlight-color:transparent;
    }
    .btn img{flex:none; width:24px; height:24px; margin-left:4px;}
    @media (hover:hover){
      .btn:hover{background-image:linear-gradient(var(--state-hovered), var(--state-hovered));}
    }
    .btn:active{background-image:linear-gradient(var(--state-pressed), var(--state-pressed));}
    /* focused: a 2px brand ring, 2px out. Shadows rather than an outline so
       the ring stays round in the flip phone's older browser; the inner one is
       the gap, in the page colour. The transparent outline shows in Windows
       high-contrast mode, which drops shadows. A browser without :focus-visible
       keeps the ring for every focus, which is what a D-pad needs. */
    .btn:focus{outline:2px solid transparent; outline-offset:2px; box-shadow:0 0 0 2px var(--bg), 0 0 0 4px var(--brand);}
    .btn:focus:not(:focus-visible){box-shadow:none; outline:none;}
    /* disabled (nothing on this page uses it yet; drop the href too) */
    .btn:disabled, .btn[aria-disabled="true"]{opacity:.38; pointer-events:none;}
    /* the logo link: the flip phone moves focus with its D-pad, and the
       focused link has to be unmistakable on a 2.8" screen */
    .logo:focus{outline:3px solid var(--brand); outline-offset:4px;}

    body{font-size:20px; line-height:28px;}
    p{color:var(--text-weak);}

    /* ---------- phone (Figma: dumb.co/signin (mobile), 390 wide) ---------- */
    .get-ff{padding:96px 32px 24px;}
    .get-ff h1{font-family:var(--body); font-weight:800; font-size:40px; line-height:1;}
    .get-ff p{margin-top:24px;}
    .get-ff .btn{margin-top:48px;}
    .get-ff__art{margin-top:48px; padding:0 32px; text-align:center;}
    .art-laptop{width:228px; max-height:240px;}

    .steps{padding:96px 32px 48px;}
    .steps h1{font-family:var(--headline); font-weight:700; font-size:48px; line-height:.9; text-align:center;}
    .steps ol{list-style:none; padding:24px 0 0;}
    .steps li{margin-top:48px;}
    .steps h2{font-family:var(--headline); font-weight:700; font-size:32px; line-height:1.1; color:var(--text-strong);}
    .step__txt{max-width:600px;}
    .step__txt p{margin-top:16px;}
    .step__txt .btn{margin-top:24px;}
    .step__img{display:block; width:100%; margin-top:32px;}
    .step__img.framed{border-radius:8px;}
    /* step 1's video: 16:9 before anything has loaded, and the brand ring
       while it or any of its controls has focus. Not :focus-visible only:
       once Tab moves into the controls, Firefox fades its control bar, and
       its own ring with it, 2s later, which would leave nothing showing
       where focus is. So a mouse click shows the ring too. */
    .step__video{height:auto; aspect-ratio:16/9;}
    .step__video:focus{outline:2px solid var(--brand); outline-offset:2px;}

    /* ---------- flip phone: 240x320 (src/Link/SpotifyLink.tsx), D-pad, no
       touch. The height keeps 360px-wide smartphones out. ---------- */
    @media (max-width:360px) and (max-height:480px){
      body{font-size:14px; line-height:20px;}
      .logo{left:12px; top:12px; width:56px;}
      .get-ff, .steps{padding:40px 12px 16px;}
      .get-ff h1{font-size:24px;}
      .get-ff p{margin-top:12px;}
      .get-ff .btn{margin-top:16px;}
      /* the button at device=dumb: smaller, a 1.5px ring 2.5px out, and the
         pressed layer on focus (the D-pad's selection) and disabled */
      .btn{font-size:16px; line-height:1.1; padding:8px 12px; text-transform:none; white-space:normal;}
      .btn img{width:18px; height:18px;}
      .btn:focus{box-shadow:inset 0 0 0 99px var(--state-pressed), 0 0 0 2.5px var(--bg), 0 0 0 4px var(--brand);}
      .btn:disabled, .btn[aria-disabled="true"]{box-shadow:inset 0 0 0 99px var(--state-pressed);}
      /* pressing a focused button shows one 10% layer, not two; where a
         pointer focus has already dropped the inset, the pressed layer stays */
      .btn:focus:active{background-image:none;}
      .btn:focus:not(:focus-visible):active{background-image:linear-gradient(var(--state-pressed), var(--state-pressed));}
      .get-ff__art{margin-top:20px; padding:0;}
      .art-laptop{width:120px;}
    }

    /* ---------- computer (Figma: 1920 x 1080 frames) ---------- */
    @media (min-width:760px){
      .phone-only{display:none;}
      .logo{left:96px; top:48px; width:133px;}

      .get-ff{display:flex; align-items:center; min-height:100vh; padding:0; box-sizing:border-box;}
      .get-ff__copy{flex:0 0 49.5%; box-sizing:border-box; padding:96px;}
      .get-ff h1{font-family:var(--headline); font-weight:700; font-size:72px; line-height:.9;}
      .get-ff__art{flex:1 1 auto; margin:0; padding:96px 48px 96px 0; text-align:center;}
      .art-phones{display:inline-block; width:534px;}
      .art-laptop{display:none;}

      .steps{padding:120px 48px 96px;}
      .steps h1{font-size:72px;}
      .steps h2{font-size:40px;}
    }

    @media (min-width:1000px){
      .steps{padding:120px 96px 227px;}
      /* Figma: 96 from the title to the steps, which have 24 of padding on
         top (the li margin), so 120 in all */
      .steps ol{display:flex; padding-top:96px;}
      /* the text grows so the three pictures line up when the copy wraps
         to different heights */
      .steps li{flex:1 1 0; min-width:0; margin:24px 0 0 48px; display:flex; flex-direction:column;}
      .steps li:first-child{margin-left:0;}
      .step__txt{min-height:196px; flex:1 0 auto;}
      .step__img{margin-top:48px;}
    }
    /* Figma annotation: 96 between the steps, 48 below 1400 */
    @media (min-width:1400px){
      .steps li{margin-left:96px;}
    }
  </style>
  <Analytics />
</head>
<body>
  <a class="logo" href={base}><img src={img.logo} alt="dumb.co" width="133" height="28" /></a>

  <!-- every browser but desktop Firefox -->
  <main class="get-ff">
    <div class="get-ff__copy">
      <h1>visit this page on a firefox browser<span class="phone-only"> on a laptop</span></h1>
      <p>for security reasons,&nbsp; signing in to ur google messages is only supported on firefox browser.</p>
      <a class="btn" href={FIREFOX_URL} rel="noopener">visit firefox website<img src={arrow.src} alt="" width="24" height="24" /></a>
    </div>
    <div class="get-ff__art">
      <img class="art-phones" src={img.phones} alt="" width="534" height="494" />
      <img class="art-laptop" src={laptop.src} alt="" width="228" height="240" loading="lazy" />
    </div>
  </main>

  <!-- desktop Firefox -->
  <main class="steps">
    <h1>signin to ur google messages on ur dumbphone</h1>
    <ol>
      {steps.map((s, i) => (
        <li>
          <div class="step__txt">
            <h2>{s.h}</h2>
            <p>{s.p}</p>
            {s.button && <a class="btn" href={XPI_URL}>add extension<img src={arrow.src} alt="" width="24" height="24" /></a>}
          </div>
          {s.video
            ? <video class="step__img step__video" width="1280" height="720" muted loop playsinline controls preload="none"
                     aria-label="screen recording: adding the extension in firefox"
                     data-poster={img.steps[i].src} data-webm={s.video.webm} data-mp4={s.video.mp4}></video>
            : <img class={s.framed ? "step__img framed" : "step__img"} src={img.steps[i].src} srcset={img.steps[i].srcset}
                   sizes={STEP_SIZES} alt="" width="1200" height="675" loading="lazy" />}
        </li>
      ))}
    </ol>
  </main>

  <!-- step 1's video loads in desktop Firefox only, so no other browser (the
       flip phone least of all) fetches it or its thumbnail. It plays muted on
       a loop, like a gif, and its controls pause it or make it full screen.
       When the computer asks for reduced motion, or Firefox is set to block
       autoplay, it waits on the thumbnail (the Figma frame's "step 1
       thumbnail") for the play button instead, and downloads no video until
       it's pressed. -->
  <script is:inline>
    (function () {
      if (!/(^|\s)ff(\s|$)/.test(document.documentElement.className)) return;
      var still = (window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches) ||
        (navigator.getAutoplayPolicy && navigator.getAutoplayPolicy("mediaelement") === "disallowed");
      var kinds = [["webm", "video/webm"], ["mp4", "video/mp4"]];
      var vids = document.querySelectorAll(".step__video");
      for (var i = 0; i < vids.length; i++) {
        var v = vids[i];
        v.muted = true;
        v.poster = v.getAttribute("data-poster");
        // autoplay alone makes Firefox load the video; preload stays "none",
        // so no video downloads while it waits for the play button
        if (!still) v.autoplay = true;
        for (var k = 0; k < kinds.length; k++) {
          var s = document.createElement("source");
          s.src = v.getAttribute("data-" + kinds[k][0]);
          s.type = kinds[k][1];
          v.appendChild(s);
        }
      }
    })();
  </script>
</body>
</html>
