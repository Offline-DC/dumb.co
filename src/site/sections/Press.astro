---
/* press.exe -- src/content/press.json; thumbnails cropped to 220px squares */
import { COPY } from "../lib/content";
import { PRESS as items } from "../lib/data";
const c = COPY.press;
---
<div id="press-mirror">
  <h1 class="pm-title">{c.heading}</h1>
  {c.contact_email && <div class="pm-sub"><a href={`mailto:${c.contact_email}`}>{c.contact_email}</a></div>}
  <div class="pm-list">
    {items.map((p) => (
      <a class="pm-row" href={p.href} target="_blank" rel="noopener">
        <img class="pm-thumb" src={p.img} alt={p.source || p.title} loading="lazy" />
        <div class="pm-body">
          <div class="pm-head">{p.title}</div>
          <div>
            {p.source && <div class="pm-source">• {p.source}</div>}
            <div class="pm-out">open article ↗</div>
          </div>
        </div>
      </a>
    ))}
  </div>
</div>
