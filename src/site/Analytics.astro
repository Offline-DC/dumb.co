---
/* Analytics, on dumb.co only -- preview and local visits stay out of the
   numbers.

   GOOGLE TAG MANAGER: put the container id (GTM-XXXXXXX, from
   tagmanager.google.com > the container > top right) in GTM_ID below and
   the standard snippet goes in on every page. Tags are then managed in
   GTM, not here. Empty = not loaded.

   GOOGLE ANALYTICS: loaded HERE, directly, and only here -- G-6J99WZC0Y0,
   the dumb.co property. (G-J6NFHL9D1L, the old "offline.community" property
   in the Offline GA account that the old site's react-ga4 also reported to,
   was retired Oct 2026 at Electric Orange's request.) Do NOT also add a
   GA4 / Google tag for this id inside GTM, or every visit is counted twice. (Oct 15: the
   GTM container has no tags in it.) If GA ever moves into GTM, add the
   tags there and delete the gtag block below in the same release.

   GTM HAS ITS OWN DATA LAYER, window.gtmDataLayer -- not the default
   window.dataLayer that gtag uses. When they shared one, GTM read gtag's
   config command for G-6J99WZC0Y0 and loaded a SECOND copy of gtag.js
   (gtag/js?id=G-6J99WZC0Y0&cx=c&gtm=...), ~180 KiB and ~120 ms of main
   thread on a phone, with no tags in the container to use it (Electric
   Orange's Oct 28 Lighthouse audit). Anything that pushes events FOR GTM
   (e.g. a purchase event on a checkout-confirmation page) pushes to
   window.gtmDataLayer. */
const GTM_ID = "GTM-KRDL288W";
const GTM_LAYER = "gtmDataLayer";
---
{GTM_ID && (
  <script is:inline define:vars={{ GTM_ID, GTM_LAYER }}>
    if(/(^|\.)dumb\.co$/.test(location.hostname)){
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
      var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
      j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script',GTM_LAYER,GTM_ID);
    }
  </script>
)}
<script is:inline>
  if(/(^|\.)dumb\.co$/.test(location.hostname)){
    var ga = document.createElement("script"); ga.async = true;
    ga.src = "https://www.googletagmanager.com/gtag/js?id=G-6J99WZC0Y0";
    document.head.appendChild(ga);
    window.dataLayer = window.dataLayer || [];
    window.gtag = function(){ dataLayer.push(arguments); };
    gtag("js", new Date());
    gtag("config", "G-6J99WZC0Y0");
  }
</script>
