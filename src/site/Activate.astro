---
/**
 * /activate -- the activation link in a unified-checkout phone's delivery
 * email (unified checkout story 4).
 *
 * The email links to dumb.co/activate/<token>. GitHub Pages can't serve a
 * page per token, so 404.astro sends that address here as
 * dumb.co/activate#<token> (query kept). The token stays in the fragment:
 * never sent to a server, never in a Referer, and this page loads no
 * analytics. Gigs Connect comes back to /activate/<token>?session_id=…&status=…
 * the same way.
 *
 * Talks straight to offline-dc-twilio from the browser (src/routes/
 * activationRoutes.js there). The token is the only key, so the API returns
 * no ICCID, IMEI, voucher code or full email:
 *   POST /activate/view             the page's view (status says which screen)
 *   POST /activate/confirm          { confirmed: true }   only if an older backend still asks for it
 *   POST /activate/session          { url } of a Gigs Connect Session: go there now
 *   POST /activate/porting_session  { url } to finish keeping an old number
 * The token always goes in the JSON body ({ token, ... }), never the API URL:
 * request paths end up in the backend's access logs, bodies don't.
 *
 * Screens (Kunal Nov 16, designer review Nov 20, one phone per order from
 * Nov 23): the dumb.co/mobile quiz's question "will you keep using a
 * smartphone alongside your dumbphone?": yes → "we recommend getting a brand
 * new number", no → "we recommend transferring your current phone number"
 * (the quiz's cards). "continue" opens Connect, where they pick new number / transfer. Live: "manage ur plan" goes to the Gigs portal.
 *
 * Looks like Gigs Connect (white page, sans headings, bordered option cards,
 * full-width dark button), so stepping from this page into Connect doesn't
 * feel like a different site (Nov 19). Our voice, logo and duck stay.
 * Not in the sitemap, noindex.
 */
import { webp } from "./lib/assets";
import fontsCss from "../../public/fonts.css?raw";
import duck from "./assets/brand/duck-dance.png";
/* The quiz pieces are shared with dumb.co/mobile (src/pages/mobile.astro):
   edit them in src/site/quiz/ and both pages change. */
import QuizLogo from "./quiz/QuizLogo.astro";
import QuizButton from "./quiz/QuizButton.astro";
import QuizSmartphoneQuestion from "./quiz/QuizSmartphoneQuestion.astro";
import QuizNewNumberCard from "./quiz/QuizNewNumberCard.astro";
import QuizTransferCard from "./quiz/QuizTransferCard.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const fontFaces = fontsCss.replace(/\/\*[\s\S]*?\*\//g, "").replace(/url\("fonts\//g, `url("${base}fonts/`).trim();

/* offline-dc-twilio (production), as on /order. PUBLIC_ORDER_API_URL points
   both pages at the sandbox while testing:
   PUBLIC_ORDER_API_URL=https://offline-dc-backend-sandbox-52e95f5b884b.herokuapp.com npm run dev */
const API_URL = (import.meta.env.PUBLIC_ORDER_API_URL || "https://offline-dc-backend-ba4815b2bcc8.herokuapp.com").replace(/\/$/, "");

/* Shown until the API answers, and if it can't. The API's view has the real ones. */
const SUPPORT = { phone: "404-716-3605", email: "support@dumb.co" };

const img = { duck: await webp(duck, { width: 240 }) };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Activate ur phone - dumb.co</title>
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <meta name="theme-color" content="#ffffff" />
  <link rel="icon" type="image/png" href={`${base}favicon.png`} />
  <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
  <style set:html={fontFaces}></style>
  <style is:inline>
    /* Matched to Gigs Connect (dumb-co-test-lsr.gigs.com checkout, Nov 19). */
    :root{
      --bg:#ffffff; --surface:#ffffff; --muted-bg:#f6f6f6; --line:#e5e5e5; --line-strong:#cfcfcf;
      --text-strong:#1f1f1f; --text-weak:#6b6b6b;
      --brand:#2b2b2b; --on-brand:#ffffff; --error:#c4372b;
      --radius:10px;
      --body:"Helvetica Now Display", "Helvetica Neue", Helvetica, Arial, sans-serif;
    }
    html,body{margin:0; padding:0; background:var(--bg); color:var(--text-strong);}
    body{font-family:var(--body); font-weight:400; font-size:17px; line-height:26px; -webkit-text-size-adjust:100%;
         min-height:100vh; min-height:100dvh; display:flex; flex-direction:column;}
    h1,h2,p,ul,dl,dd{margin:0; padding:0;}
    p{color:var(--text-weak);}
    a{color:var(--text-strong);}
    [hidden]{display:none !important;}

    /* Like dumb.co/mobile: logo at the top (15px), the screen's content in the
       middle of what's left, the footer at the bottom. */
    main{flex:1; display:flex; flex-direction:column; width:100%; max-width:600px; box-sizing:border-box; margin:0 auto; padding:15px 24px 15px;}
    .brand{display:flex; justify-content:center; color:#000; text-decoration:none;}
    .brand:focus-visible{outline:2px solid var(--brand); outline-offset:4px;}

    h1{font-weight:600; font-size:30px; line-height:1.2; letter-spacing:-.01em;}
    h2{font-weight:600; font-size:22px; line-height:1.3; margin-top:32px;}
    .lead{margin-top:12px;}

    .state{display:none;}
    .state.on{display:block; margin-top:32px;}
    .state.quiz.on{flex:1; display:flex; flex-direction:column; margin-top:0;}
    .quiz-body{flex:1; display:flex; flex-direction:column; justify-content:center; padding:8px 0 48px;}
    /* Bottom-left link, like /mobile's "start over" */
    /* Bottom bar copied from /mobile's (its .topbar under each question): full
       screen width, three columns 1fr auto 1fr, 12px gap, padding
       clamp(16px,4vw,40px) at the sides. "start over" sits in the left column,
       stretched across it with its text centered, exactly as on /mobile. The
       margin undoes main's centering (max-width 600px) and 24px padding. */
    .quiz-bottom{
      display:grid; grid-template-columns:1fr auto 1fr; align-items:center; gap:12px; box-sizing:border-box;
      width:100vw; margin-left:calc((min(100vw, 600px) - 100vw) / 2 - 24px);
      padding:0 clamp(16px,4vw,40px);
    }
    .quiz-back{
      font-family:-apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-size:13px; line-height:normal; font-weight:600; text-decoration:underline; text-underline-offset:3px;
      background:none; border:none; cursor:pointer; color:#000; opacity:.7; padding:4px 0;
      -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale;
    }
    .quiz-back:hover{opacity:1;}
    .quiz-back--spacer{display:inline-block; visibility:hidden; cursor:default;}

    .card{margin-top:24px; padding:20px 24px; background:var(--surface); border:1px solid var(--line); border-radius:var(--radius);}

    /* Label over value, rows split by hairlines (Connect's "Account Details"). */
    .details{display:block;}
    .details dt{font-size:14px; line-height:20px; color:var(--text-weak); padding-top:14px;}
    .details dt:first-child{padding-top:0;}
    .details dd{color:var(--text-strong); padding:2px 0 14px; border-bottom:1px solid var(--line); overflow-wrap:anywhere;}
    .details dd:last-child{border-bottom:0; padding-bottom:0;}



    .msg{margin-top:16px; color:var(--error);}
    .msg:empty{display:none;}
    .info{margin-top:16px;}
    .info:empty{display:none;}


    /* One full-width dark button, like Connect's "Pay Now". */
    .actions{margin-top:32px; display:flex; flex-direction:column; gap:16px; align-items:stretch;}
    .btn{
      display:flex; align-items:center; justify-content:center; box-sizing:border-box; width:100%; min-height:52px;
      background-color:var(--brand); color:var(--on-brand); border:0; cursor:pointer;
      border-radius:8px; padding:14px 20px; text-decoration:none;
      font-family:var(--body); font-weight:600; font-size:17px; line-height:1.4;
      -webkit-tap-highlight-color:transparent;
    }
    @media (hover:hover){ .btn:hover{background-color:#111;} }
    .btn:active{background-color:#000;}
    .btn:focus-visible{outline:2px solid var(--brand); outline-offset:3px;}
    .btn:disabled{background-color:#d6d6d6; color:#ffffff; cursor:default;}
    .link{align-self:center; background:none; border:0; padding:0; font:inherit; font-size:16px; color:var(--text-weak); text-decoration:underline; cursor:pointer;}



    /* Quiz screens: the pieces come from src/site/quiz/ (shared with /mobile). */
    .quiz{text-align:center;}
    .quiz-actions{display:flex; flex-direction:column; gap:18px; align-items:center; margin-top:4px;}

    .duck{display:block; width:120px; height:auto; margin-top:24px;}


    @media (min-width:760px){
      h1{font-size:34px;}
    }
  </style>
</head>
<body>
  <main>
    <a class="brand" href={base} aria-label="dumb.co home"><QuizLogo /></a>

    <section class="state on" data-state="loading" aria-live="polite">
      <h1>one sec…</h1>
    </section>

    <section class="state" data-state="missing">
      <h1>this link doesn't work</h1>
      <p class="lead">check u opened the latest email from us. still stuck? we'll sort it out: call <a data-support-phone></a> or email <a data-support-email></a>.</p>
    </section>

    <section class="state" data-state="error">
      <h1>something went wrong</h1>
      <p class="lead" data-error-detail>try again in a minute.</p>
      <p class="actions"><button class="btn" type="button" data-retry>try again</button></p>
    </section>

    <section class="state quiz" data-state="ready">
      <div class="quiz-body">
        <p class="info" data-ready-note></p>
        <QuizSmartphoneQuestion yes={{ "data-answer": "yes" }} no={{ "data-answer": "no" }} />
      </div>
      <!-- same height as the link on the other screens, so the question sits where /mobile's does -->
      <div class="quiz-bottom" aria-hidden="true"><span class="quiz-back quiz-back--spacer">&nbsp;</span></div>
    </section>

    <section class="state quiz" data-state="rec-new">
      <div class="quiz-body">
        <QuizNewNumberCard />
        <p class="msg" data-activate-msg role="alert"></p>
        <div class="quiz-actions">
          <QuizButton data-activate>continue</QuizButton>
        </div>
      </div>
      <div class="quiz-bottom"><button class="quiz-back" type="button" data-back>start over</button></div>
    </section>

    <section class="state quiz" data-state="rec-transfer">
      <div class="quiz-body">
        <QuizTransferCard />
        <p class="msg" data-activate-msg role="alert"></p>
        <div class="quiz-actions">
          <QuizButton data-activate>continue</QuizButton>
        </div>
      </div>
      <div class="quiz-bottom"><button class="quiz-back" type="button" data-back>start over</button></div>
    </section>

    <section class="state" data-state="activating" aria-live="polite">
      <h1>switching on ur line</h1>
      <p class="lead" data-activating-lead>this usually takes a minute or two. this page updates by itself.</p>
      <div class="card" data-porting hidden>
        <h2>finish keeping ur number</h2>
        <p class="info" data-porting-lead></p>
        <p class="msg" data-porting-msg role="alert"></p>
        <p class="actions"><button class="btn" type="button" data-porting-go>finish</button></p>
      </div>
    </section>

    <section class="state" data-state="live">
      <h1>ur live 🦆</h1>
      <img class="duck" src={img.duck} alt="dumb.co duck" width="120" height="87" />
      <p class="lead" data-live-lead>ur phone's ready to use.</p>
      <p class="actions"><a class="btn" data-portal>manage ur plan</a></p>
      <p class="info" data-portal-note></p>
      <div class="card" data-porting-live hidden>
        <h2>finish keeping ur number</h2>
        <p class="info" data-porting-live-lead></p>
        <p class="actions"><button class="btn" type="button" data-porting-go>finish</button></p>
      </div>
    </section>

    <section class="state" data-state="blocked">
      <h1>let's get this sorted</h1>
      <p class="lead" data-blocked-lead></p>
      <p class="lead">call us at <a data-support-phone></a> or email <a data-support-email></a>.</p>
    </section>

    <section class="state" data-state="ended">
      <h1>this line isn't active</h1>
      <p class="lead">it's been cancelled. questions? call <a data-support-phone></a> or email <a data-support-email></a>.</p>
    </section>
  </main>


  <script is:inline define:vars={{ API_URL, SUPPORT }}>
  (function () {
    var token = (location.hash || "").replace(/^#/, "");
    var params = new URLSearchParams(location.search);
    var back = params.get("status"); // from Connect: success | user_aborted | auth_expired | bad_configuration
    if (back || params.get("session_id")) history.replaceState(null, "", location.pathname + location.hash);
    var view = null;
    var polls = 0;
    var MAX_POLLS = 36; // ~3 min at 5s

    function $(sel, root) { return (root || document).querySelector(sel); }
    function $$(sel) { return Array.prototype.slice.call(document.querySelectorAll(sel)); }
    function el(tag, attrs, text) {
      var n = document.createElement(tag);
      if (attrs) for (var k in attrs) n.setAttribute(k, attrs[k]);
      if (text != null) n.textContent = text; // never innerHTML: names come from buyers
      return n;
    }
    function show(state) {
      $$("[data-state]").forEach(function (s) { s.classList.toggle("on", s.getAttribute("data-state") === state); });
      window.scrollTo(0, 0);
    }
    function support(s) {
      s = s || SUPPORT;
      $$("[data-support-phone]").forEach(function (a) { a.textContent = s.phone; a.href = "tel:" + s.phone.replace(/[^0-9+]/g, ""); });
      $$("[data-support-email]").forEach(function (a) { a.textContent = s.email; a.href = "mailto:" + s.email; });
    }
    function fail(msg) { $("[data-error-detail]").textContent = msg || "try again in a minute."; show("error"); }
    var BLOCKED = {
      details_wrong: "thanks for flagging it. we've paused activation for this phone until our team fixes ur details.",
      imei_mismatch: "those digits didn't match the phone we sent for this link, so we've paused activation in case it's the wrong box.",
      // Story 7: the plan's Stripe billing is over before activation.
      payment_failed: "ur first payment didn't go through, so we've paused activation. reach out and we'll get it sorted.",
    };

    // Keeping their old number and the transfer needs them (account number,
    // PIN…): a button straight to that step in Connect.
    function porting() {
      var p = view && view.porting;
      var lead = p && p.declined
        ? "ur old carrier didn't accept the transfer. check ur account number and transfer PIN with them, then try again."
        : "we need a few more details from ur old carrier (like ur account number and transfer PIN) to move ur number over.";
      $("[data-porting]").hidden = !p;
      $("[data-porting-live]").hidden = !p;
      $("[data-porting-lead]").textContent = p ? lead : "";
      $("[data-porting-live-lead]").textContent = p ? lead : "";
      if (p) $("[data-activating-lead]").textContent = "ur line's almost ready.";
    }

    function render(v) {
      view = v;
      support(v.support);
      if (v.status === "confirm" || v.status === "ready") return renderReady();
      porting();
      if (v.status === "activating") return show("activating");
      if (v.status === "live") return renderLive();
      if (v.status === "blocked") {
        $("[data-blocked-lead]").textContent = BLOCKED[v.block_reason] || "we hit a snag setting up ur line, and our team's been told.";
        return show("blocked");
      }
      if (v.status === "ended") return show("ended");
      fail();
    }

    // The quiz: yes → new number card, no → transfer card. "change my answer"
    // goes back to the question.
    $$("[data-answer]").forEach(function (b) {
      b.addEventListener("click", function () { show(b.getAttribute("data-answer") === "yes" ? "rec-new" : "rec-transfer"); });
    });
    $$("[data-back]").forEach(function (b) { b.addEventListener("click", function () { show("ready"); }); });

    function renderReady() {
      var notes = {
        user_aborted: "u stopped before finishing. tap continue to pick up where u left off.",
        auth_expired: "that took a while, so the link timed out. tap continue to start again.",
        bad_configuration: "something went wrong on our side. try again, or call us if it keeps happening.",
      };
      $("[data-ready-note]").textContent = notes[back] || "";
      $$("[data-activate-msg]").forEach(function (m) { m.textContent = ""; });
      show("ready");
    }

    function renderLive() {
      $("[data-live-lead]").textContent = view.phone_number_last4
        ? "ur number ends in " + view.phone_number_last4 + ". ur phone's ready to use."
        : "ur phone's ready to use.";
      var a = $("[data-portal]");
      a.href = view.portal_url;
      $("[data-portal-note]").textContent = view.email ? "sign in with " + view.email + "." : "";
      show("live");
    }

    // Every call is a POST with the token in the body (see the top of this file).
    function api(action, body) {
      var payload = Object.assign({}, body || {}, { token: token });
      return fetch(API_URL + "/activate/" + action, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
        referrerPolicy: "no-referrer",
        cache: "no-store",
      }).then(function (res) {
        return res.json().catch(function () { return {}; }).then(function (data) { return { status: res.status, data: data }; });
      });
    }

    function load() {
      api("view").then(function (r) {
        if (r.status === 200) {
          // Back from Connect with success: keep the "switching on" screen up
          // and poll until Gigs tells us the line is live.
          if (back === "success" && (r.data.status === "ready" || r.data.status === "activating")) {
            view = r.data;
            support(view.support);
            porting();
            show("activating");
            if (polls++ < MAX_POLLS) return setTimeout(load, 5000);
            $("[data-activating-lead]").textContent = "this is taking longer than usual. if ur keeping ur number, the transfer can take a few hours. come back to this page any time.";
            return;
          }
          render(r.data);
          if (r.data.status === "activating" && polls++ < MAX_POLLS) setTimeout(load, 5000);
        } else if (r.status === 404) {
          show("missing");
        } else if (r.status === 429) {
          fail("too many tries from this connection. wait a bit and try again.");
        } else {
          fail();
        }
      }).catch(function () { fail("check ur connection and try again."); });
    }

    // Continue: ask for the Connect session and go straight there.
    $$("[data-activate]").forEach(function (b) { b.addEventListener("click", function () {
      var btn = this;
      var msg = $("[data-activate-msg]", btn.closest("section"));
      msg.textContent = "";
      function reset() { btn.disabled = false; btn.textContent = "continue"; }
      btn.disabled = true;
      btn.textContent = "one sec…";
      // One phone per order: nothing to check. A backend that still has the
      // old confirm step gets it ticked here first.
      var first = view && view.status === "confirm"
        ? api("confirm", { confirmed: true }).then(function (r) { if (r.status === 200) view = r.data; })
        : Promise.resolve();
      first.then(function () { return api("session"); }).then(function (r) {
        // The url signs them in: go straight there, never keep it.
        if (r.status === 200 && r.data.url) return location.assign(r.data.url);
        reset();
        if (r.status === 409 && r.data.error === "already_active") {
          show("activating");
          setTimeout(load, 5000);
          return;
        }
        if (r.status === 409 || r.status === 423) return render(r.data);
        if (r.status === 429) { msg.textContent = "one sec, then tap continue again."; return; }
        if (r.status === 404) return show("missing");
        msg.textContent = "couldn't start activation just now. try again in a minute.";
      }).catch(function () {
        reset();
        msg.textContent = "couldn't reach us. check ur connection and try again.";
      });
    }); });

    $$("[data-porting-go]").forEach(function (b) {
      b.addEventListener("click", function () {
        var btn = this;
        btn.disabled = true;
        btn.textContent = "one sec…";
        api("porting_session").then(function (r) {
          if (r.status === 200 && r.data.url) return location.assign(r.data.url);
          btn.disabled = false;
          btn.textContent = "finish";
          if (r.status === 409) return render(r.data);
          $("[data-porting-msg]").textContent = r.status === 429 ? "one sec, then try again." : "couldn't open that just now. try again in a minute.";
        }).catch(function () {
          btn.disabled = false;
          btn.textContent = "finish";
          $("[data-porting-msg]").textContent = "couldn't reach us. check ur connection and try again.";
        });
      });
    });

    $("[data-retry]").addEventListener("click", function () { polls = 0; show("loading"); load(); });

    // Back from Gigs with the browser's back button: phones show the page as it
    // was left (button still "one sec…"), so reset the buttons and check the
    // line again. A line that's still waiting keeps the screen they were on.
    window.addEventListener("pageshow", function (e) {
      if (!e.persisted) return;
      $$("[data-activate]").forEach(function (b) { b.disabled = false; b.textContent = "continue"; });
      $$("[data-porting-go]").forEach(function (b) { b.disabled = false; b.textContent = "finish"; });
      $$("[data-activate-msg], [data-porting-msg]").forEach(function (m) { m.textContent = ""; });
      if (!/^[A-Za-z0-9_-]{43}$/.test(token)) return;
      var on = $(".state.on");
      var here = on && on.getAttribute("data-state");
      api("view").then(function (r) {
        if (r.status !== 200) return;
        if (r.data.status === "ready" && /^(ready|rec-new|rec-transfer)$/.test(here)) { view = r.data; return; }
        polls = 0;
        render(r.data);
        if (r.data.status === "activating" && polls++ < MAX_POLLS) setTimeout(load, 5000);
      }).catch(function () {});
    });

    support();
    if (!/^[A-Za-z0-9_-]{43}$/.test(token)) show("missing");
    else load();
  })();
  </script>
</body>
</html>
