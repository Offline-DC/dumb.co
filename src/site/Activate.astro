---
/**
 * /activate -- the activation link in a unified-checkout phone's delivery
 * email (unified checkout story 4).
 *
 * The email links to dumb.co/activate/<token>. GitHub Pages can't serve a
 * page per token, so 404.astro sends that address here as
 * dumb.co/activate#<token> (query kept). The token stays in the fragment:
 * never sent to a server, never in a Referer, and this page loads no
 * analytics. Gigs Connect comes back to /activate/<token>?session_id=…&status=…
 * the same way.
 *
 * Talks straight to offline-dc-twilio from the browser (src/routes/
 * activationRoutes.js there). The token is the only key, so the API returns
 * no ICCID, IMEI, voucher code or full email:
 *   POST /activate/view             the page's view (status says which screen)
 *   POST /activate/confirm          { confirmed: true, imei }   checkbox + IMEI ending
 *   POST /activate/not_right        pauses activation, tells our team
 *   POST /activate/session          { url } of a Gigs Connect Session: go there now
 *   POST /activate/porting_session  { url } to finish keeping an old number
 * The token always goes in the JSON body ({ token, ... }), never the API URL:
 * request paths end up in the backend's access logs, bodies don't.
 *
 * Screens (agreed with Kunal, Nov 16): check the details and tick one box,
 * type the end of the IMEI from the box (5 tries), then activate in Connect
 * ($0 there; the plan is billed by us). "Something's not right" or 5 wrong
 * tries pause activation until support sorts it out. Live: "manage ur plan"
 * goes to the Gigs portal.
 *
 * Looks like Gigs Connect (white page, sans headings, bordered option cards,
 * full-width dark button), so stepping from this page into Connect doesn't
 * feel like a different site (Nov 19). Our voice, logo and duck stay.
 * Not in the sitemap, noindex.
 */
import { webp } from "./lib/assets";
import fontsCss from "../../public/fonts.css?raw";
import logo from "./assets/brand/logo.webp";
import duck from "./assets/brand/duck-dance.png";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const fontFaces = fontsCss.replace(/\/\*[\s\S]*?\*\//g, "").replace(/url\("fonts\//g, `url("${base}fonts/`).trim();

/* offline-dc-twilio (production), as on /order. PUBLIC_ORDER_API_URL points
   both pages at the sandbox while testing:
   PUBLIC_ORDER_API_URL=https://offline-dc-backend-sandbox-52e95f5b884b.herokuapp.com npm run dev */
const API_URL = (import.meta.env.PUBLIC_ORDER_API_URL || "https://offline-dc-backend-ba4815b2bcc8.herokuapp.com").replace(/\/$/, "");

/* Shown until the API answers, and if it can't. The API's view has the real ones. */
const SUPPORT = { phone: "404-716-3605", email: "support@dumb.co" };

const img = { logo: await webp(logo, { width: 240 }), duck: await webp(duck, { width: 240 }) };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Activate ur phone - dumb.co</title>
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <meta name="theme-color" content="#ffffff" />
  <link rel="icon" type="image/png" href={`${base}favicon.png`} />
  <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
  <style set:html={fontFaces}></style>
  <style is:inline>
    /* Matched to Gigs Connect (dumb-co-test-lsr.gigs.com checkout, Nov 19). */
    :root{
      --bg:#ffffff; --surface:#ffffff; --muted-bg:#f6f6f6; --line:#e5e5e5; --line-strong:#cfcfcf;
      --text-strong:#1f1f1f; --text-weak:#6b6b6b;
      --brand:#2b2b2b; --on-brand:#ffffff; --error:#c4372b;
      --radius:10px;
      --body:"Helvetica Now Display", "Helvetica Neue", Helvetica, Arial, sans-serif;
    }
    html,body{margin:0; padding:0; background:var(--bg); color:var(--text-strong);}
    body{font-family:var(--body); font-weight:400; font-size:17px; line-height:26px; -webkit-text-size-adjust:100%;}
    h1,h2,p,ul,dl,dd{margin:0; padding:0;}
    p{color:var(--text-weak);}
    a{color:var(--text-strong);}
    [hidden]{display:none !important;}

    main{max-width:600px; margin:0 auto; padding:32px 24px 32px;}
    .logo{display:block; width:96px; line-height:0; margin-bottom:32px;}
    .logo img{width:100%; height:auto;}
    .logo:focus-visible{outline:2px solid var(--brand); outline-offset:4px;}

    h1{font-weight:600; font-size:30px; line-height:1.2; letter-spacing:-.01em;}
    h2{font-weight:600; font-size:22px; line-height:1.3; margin-top:32px;}
    .lead{margin-top:12px;}
    .test{display:inline-block; margin-bottom:16px; padding:2px 10px; border:1px solid var(--line-strong); border-radius:96px; color:var(--text-weak); font-size:13px; line-height:20px;}

    .state{display:none;}
    .state.on{display:block;}

    .card{margin-top:24px; padding:20px 24px; background:var(--surface); border:1px solid var(--line); border-radius:var(--radius);}

    /* Label over value, rows split by hairlines (Connect's "Account Details"). */
    .details{display:block;}
    .details dt{font-size:14px; line-height:20px; color:var(--text-weak); padding-top:14px;}
    .details dt:first-child{padding-top:0;}
    .details dd{color:var(--text-strong); padding:2px 0 14px; border-bottom:1px solid var(--line); overflow-wrap:anywhere;}
    .details dd:last-child{border-bottom:0; padding-bottom:0;}

    .check{display:flex; gap:12px; align-items:flex-start; margin-top:20px; cursor:pointer; color:var(--text-strong);}
    .check input{width:20px; height:20px; margin:3px 0 0; accent-color:var(--brand); flex:none;}

    .field{display:block; margin-top:24px;}
    .field__label{display:block; font-size:16px; line-height:22px; font-weight:600; color:var(--text-strong);}
    .field__hint{display:block; font-size:14px; line-height:20px; color:var(--text-weak);}
    .field input{
      display:block; width:8em; box-sizing:border-box; margin-top:8px;
      background:var(--bg); color:var(--text-strong); border:1px solid var(--line-strong); border-radius:8px;
      padding:12px 14px; font:inherit; font-size:20px; letter-spacing:.2em;
    }
    .field input:focus{outline:2px solid var(--brand); outline-offset:1px;}
    .field input[aria-invalid="true"]{border-color:var(--error);}

    .msg{margin-top:16px; color:var(--error);}
    .msg:empty{display:none;}
    .info{margin-top:16px;}
    .info:empty{display:none;}

    /* Connect's info box: bordered, an (i) on the left, grey text. */
    .note{display:flex; gap:14px; align-items:flex-start; margin-top:24px; padding:20px; border:1px solid var(--line); border-radius:var(--radius); color:var(--text-weak);}
    .note svg{flex:none; width:22px; height:22px; margin-top:2px; color:var(--text-strong);}

    /* One full-width dark button, like Connect's "Pay Now". */
    .actions{margin-top:32px; display:flex; flex-direction:column; gap:16px; align-items:stretch;}
    .btn{
      display:flex; align-items:center; justify-content:center; box-sizing:border-box; width:100%; min-height:52px;
      background-color:var(--brand); color:var(--on-brand); border:0; cursor:pointer;
      border-radius:8px; padding:14px 20px; text-decoration:none;
      font-family:var(--body); font-weight:600; font-size:17px; line-height:1.4;
      -webkit-tap-highlight-color:transparent;
    }
    @media (hover:hover){ .btn:hover{background-color:#111;} }
    .btn:active{background-color:#000;}
    .btn:focus-visible{outline:2px solid var(--brand); outline-offset:3px;}
    .btn:disabled{background-color:#d6d6d6; color:#ffffff; cursor:default;}
    .link{align-self:center; background:none; border:0; padding:0; font:inherit; font-size:16px; color:var(--text-weak); text-decoration:underline; cursor:pointer;}

    .confirm-wrong{margin-top:24px; padding:20px; border:1px solid var(--line); border-radius:var(--radius); background:var(--muted-bg);}
    .confirm-wrong[hidden]{display:none;}
    .confirm-wrong p{color:var(--text-strong);}

    /* Number choice: Connect's option cards (title, grey text, chevron). */
    .options{display:flex; flex-direction:column; gap:16px; margin-top:16px;}
    .option{
      display:flex; align-items:center; gap:16px; width:100%; box-sizing:border-box; text-align:left;
      padding:20px 20px 20px 24px; background:var(--surface); color:inherit; font:inherit;
      border:1px solid var(--line); border-radius:var(--radius); cursor:pointer;
    }
    .option__text{flex:1; display:flex; flex-direction:column; gap:4px;}
    .option__title{font-weight:600; color:var(--text-strong);}
    .option__desc{color:var(--text-weak);}
    .option svg{flex:none; width:20px; height:20px; color:var(--text-strong);}
    @media (hover:hover){ .option:hover{border-color:var(--line-strong);} }
    .option[aria-pressed="true"]{border-color:var(--brand); box-shadow:inset 0 0 0 1px var(--brand);}
    .option:focus-visible{outline:2px solid var(--brand); outline-offset:2px;}

    .duck{display:block; width:120px; height:auto; margin-top:24px;}

    footer{max-width:600px; margin:0 auto; padding:0 24px 48px; font-size:15px; line-height:22px; color:var(--text-weak);}
    footer a{color:var(--text-weak);}

    @media (min-width:760px){
      main{padding-top:56px;}
      h1{font-size:34px;}
    }
  </style>
</head>
<body>
  <main>
    <a class="logo" href={base}><img src={img.logo} alt="dumb.co" width="96" height="21" /></a>
    <p class="test" data-test hidden>test order</p>

    <section class="state on" data-state="loading" aria-live="polite">
      <h1>one sec…</h1>
    </section>

    <section class="state" data-state="missing">
      <h1>this link doesn't work</h1>
      <p class="lead">check u opened the latest email from us. still stuck? we'll sort it out: call <a data-support-phone></a> or email <a data-support-email></a>.</p>
    </section>

    <section class="state" data-state="error">
      <h1>something went wrong</h1>
      <p class="lead" data-error-detail>try again in a minute.</p>
      <p class="actions"><button class="btn" type="button" data-retry>try again</button></p>
    </section>

    <section class="state" data-state="confirm">
      <h1>let's switch on ur plan</h1>
      <p class="lead">first, check this is ur phone.</p>
      <form class="card" data-confirm-form novalidate>
        <dl class="details" data-details></dl>
        <label class="check">
          <input type="checkbox" data-confirm-box />
          <span>all of this is right</span>
        </label>
        <label class="field" data-imei-field>
          <span class="field__label" data-imei-label>last 4 digits of the IMEI</span>
          <span class="field__hint">on the sticker on ur phone's box, next to “IMEI”. not the SIM number.</span>
          <input type="text" inputmode="numeric" autocomplete="off" pattern="[0-9]*" data-imei-input />
        </label>
        <p class="msg" data-confirm-msg role="alert"></p>
        <p class="actions"><button class="btn" type="submit" data-confirm-submit>continue</button></p>
        <p class="info"><button class="link" type="button" data-wrong-open>something's not right</button></p>
        <div class="confirm-wrong" data-wrong-panel hidden>
          <p>we'll pause activation for this phone and our team will fix it with u. u can also call <a data-support-phone></a>.</p>
          <p class="actions">
            <button class="btn" type="button" data-wrong-send>pause and get help</button>
            <button class="link" type="button" data-wrong-close>go back</button>
          </p>
        </div>
      </form>
    </section>

    <section class="state" data-state="ready">
      <h1>ready when u are</h1>
      <p class="info" data-ready-note></p>
      <div class="card">
        <dl class="details" data-details-ready></dl>
      </div>
      <h2>how will u use ur dumbphone?</h2>
      <p class="lead">u'll pick one of these again on the next screen.</p>
      <div class="options">
        <button class="option" type="button" aria-pressed="false" data-port="new">
          <span class="option__text">
            <span class="option__title">get a new number</span>
            <span class="option__desc">choose this option if u want to use ur dumbphone with a smartphone. ur dumbphone will have its own number and ur smartphone will continue working.</span>
          </span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
        </button>
        <button class="option" type="button" aria-pressed="false" data-port="transfer">
          <span class="option__text">
            <span class="option__title">transfer my existing number</span>
            <span class="option__desc">only choose this option if u don't want to use a smartphone anymore. the dumbphone will be ur only device. once ur number is transferred, ur previous plan is cancelled on ur old phone.</span>
          </span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
        </button>
      </div>
      <div class="note">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M12 11v6"/><circle cx="12" cy="7.5" r=".6" fill="currentColor"/></svg>
        <p>tap activate to set up ur line. it opens our network partner's checkout, with ur plan and SIM already filled in. it's $0 there: ur plan is billed by us.</p>
      </div>
      <p class="msg" data-activate-msg role="alert"></p>
      <p class="actions"><button class="btn" type="button" data-activate>activate</button></p>
    </section>

    <section class="state" data-state="activating" aria-live="polite">
      <h1>switching on ur line</h1>
      <p class="lead" data-activating-lead>this usually takes a minute or two. this page updates by itself.</p>
      <div class="card" data-porting hidden>
        <h2>finish keeping ur number</h2>
        <p class="info" data-porting-lead></p>
        <p class="msg" data-porting-msg role="alert"></p>
        <p class="actions"><button class="btn" type="button" data-porting-go>finish</button></p>
      </div>
    </section>

    <section class="state" data-state="live">
      <h1>ur live 🦆</h1>
      <img class="duck" src={img.duck} alt="dumb.co duck" width="120" height="87" />
      <p class="lead" data-live-lead>ur phone's ready to use.</p>
      <p class="actions"><a class="btn" data-portal>manage ur plan</a></p>
      <p class="info" data-portal-note></p>
      <div class="card" data-porting-live hidden>
        <h2>finish keeping ur number</h2>
        <p class="info" data-porting-live-lead></p>
        <p class="actions"><button class="btn" type="button" data-porting-go>finish</button></p>
      </div>
    </section>

    <section class="state" data-state="blocked">
      <h1>let's get this sorted</h1>
      <p class="lead" data-blocked-lead></p>
      <p class="lead">call us at <a data-support-phone></a> or email <a data-support-email></a>.</p>
    </section>

    <section class="state" data-state="ended">
      <h1>this line isn't active</h1>
      <p class="lead">it's been cancelled. questions? call <a data-support-phone></a> or email <a data-support-email></a>.</p>
    </section>
  </main>

  <footer>questions? call <a data-support-phone></a> or email <a data-support-email></a>.</footer>

  <script is:inline define:vars={{ API_URL, SUPPORT }}>
  (function () {
    var token = (location.hash || "").replace(/^#/, "");
    var params = new URLSearchParams(location.search);
    var back = params.get("status"); // from Connect: success | user_aborted | auth_expired | bad_configuration
    if (back || params.get("session_id")) history.replaceState(null, "", location.pathname + location.hash);
    var view = null;
    var polls = 0;
    var MAX_POLLS = 36; // ~3 min at 5s

    function $(sel, root) { return (root || document).querySelector(sel); }
    function $$(sel) { return Array.prototype.slice.call(document.querySelectorAll(sel)); }
    function el(tag, attrs, text) {
      var n = document.createElement(tag);
      if (attrs) for (var k in attrs) n.setAttribute(k, attrs[k]);
      if (text != null) n.textContent = text; // never innerHTML: names come from buyers
      return n;
    }
    function show(state) {
      $$("[data-state]").forEach(function (s) { s.classList.toggle("on", s.getAttribute("data-state") === state); });
      window.scrollTo(0, 0);
    }
    function support(s) {
      s = s || SUPPORT;
      $$("[data-support-phone]").forEach(function (a) { a.textContent = s.phone; a.href = "tel:" + s.phone.replace(/[^0-9+]/g, ""); });
      $$("[data-support-email]").forEach(function (a) { a.textContent = s.email; a.href = "mailto:" + s.email; });
    }
    function fail(msg) { $("[data-error-detail]").textContent = msg || "try again in a minute."; show("error"); }
    function money(p) {
      if (!p) return null;
      var n = p.amount_cents / 100;
      return (p.currency === "usd" ? "$" : p.currency.toUpperCase() + " ") + (n % 1 ? n.toFixed(2) : n) + "/mo";
    }
    function day(iso) {
      if (!iso) return null;
      return new Date(iso).toLocaleDateString("en-US", { month: "long", day: "numeric" }).toLowerCase();
    }
    function details(dl) {
      dl.textContent = "";
      function row(k, v) { if (v) { dl.appendChild(el("dt", null, k)); dl.appendChild(el("dd", null, v)); } }
      row("phone", view.device ? view.device + (view.phone_of ? " · " + view.phone_of.position + " of " + view.phone_of.of : "") : null);
      row("name", view.name);
      row("email", view.email);
      row("plan", view.plan && view.plan.name ? view.plan.name.toLowerCase() + (view.price ? " · " + money(view.price) : "") : null);
      if (view.payment) row(view.payment.first ? "first payment" : "next payment", day(view.payment.at));
    }

    var BLOCKED = {
      details_wrong: "thanks for flagging it. we've paused activation for this phone until our team fixes ur details.",
      imei_mismatch: "those digits didn't match the phone we sent for this link, so we've paused activation in case it's the wrong box.",
      // Story 7: the plan's Stripe billing is over before activation.
      payment_failed: "ur first payment didn't go through, so we've paused activation. reach out and we'll get it sorted.",
    };

    // Keeping their old number and the transfer needs them (account number,
    // PIN…): a button straight to that step in Connect.
    function porting() {
      var p = view && view.porting;
      var lead = p && p.declined
        ? "ur old carrier didn't accept the transfer. check ur account number and transfer PIN with them, then try again."
        : "we need a few more details from ur old carrier (like ur account number and transfer PIN) to move ur number over.";
      $("[data-porting]").hidden = !p;
      $("[data-porting-live]").hidden = !p;
      $("[data-porting-lead]").textContent = p ? lead : "";
      $("[data-porting-live-lead]").textContent = p ? lead : "";
      if (p) $("[data-activating-lead]").textContent = "ur line's almost ready.";
    }

    function render(v) {
      view = v;
      support(v.support);
      $("[data-test]").hidden = !v.test;
      if (v.status === "confirm") return renderConfirm();
      if (v.status === "ready") return renderReady();
      porting();
      if (v.status === "activating") return show("activating");
      if (v.status === "live") return renderLive();
      if (v.status === "blocked") {
        $("[data-blocked-lead]").textContent = BLOCKED[v.block_reason] || "we hit a snag setting up ur line, and our team's been told.";
        return show("blocked");
      }
      if (v.status === "ended") return show("ended");
      fail();
    }

    function renderConfirm() {
      details($("[data-details]"));
      var f = $("[data-imei-field]");
      var input = $("[data-imei-input]");
      if (view.imei) {
        f.hidden = false;
        $("[data-imei-label]").textContent = "last " + view.imei.digits + " digits of the IMEI";
        input.maxLength = view.imei.digits;
        input.size = view.imei.digits + 2;
      } else {
        f.hidden = true;
      }
      $("[data-confirm-msg]").textContent = "";
      $("[data-wrong-panel]").hidden = true;
      show("confirm");
    }

    function renderReady() {
      details($("[data-details-ready]"));
      var notes = {
        user_aborted: "u stopped before finishing. tap activate to pick up where u left off.",
        auth_expired: "that took a while, so the link timed out. tap activate to start again.",
        bad_configuration: "something went wrong on our side. try again, or call us if it keeps happening.",
      };
      $("[data-ready-note]").textContent = notes[back] || "";
      $("[data-activate-msg]").textContent = "";
      show("ready");
    }

    function renderLive() {
      $("[data-live-lead]").textContent = view.phone_number_last4
        ? "ur number ends in " + view.phone_number_last4 + ". ur phone's ready to use."
        : "ur phone's ready to use.";
      var a = $("[data-portal]");
      a.href = view.portal_url;
      $("[data-portal-note]").textContent = view.email ? "sign in with " + view.email + "." : "";
      show("live");
    }

    // Every call is a POST with the token in the body (see the top of this file).
    function api(action, body) {
      var payload = Object.assign({}, body || {}, { token: token });
      return fetch(API_URL + "/activate/" + action, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
        referrerPolicy: "no-referrer",
        cache: "no-store",
      }).then(function (res) {
        return res.json().catch(function () { return {}; }).then(function (data) { return { status: res.status, data: data }; });
      });
    }

    function load() {
      api("view").then(function (r) {
        if (r.status === 200) {
          // Back from Connect with success: keep the "switching on" screen up
          // and poll until Gigs tells us the line is live.
          if (back === "success" && (r.data.status === "ready" || r.data.status === "activating")) {
            view = r.data;
            support(view.support);
            porting();
            show("activating");
            if (polls++ < MAX_POLLS) return setTimeout(load, 5000);
            $("[data-activating-lead]").textContent = "this is taking longer than usual. if ur keeping ur number, the transfer can take a few hours. come back to this page any time.";
            return;
          }
          render(r.data);
          if (r.data.status === "activating" && polls++ < MAX_POLLS) setTimeout(load, 5000);
        } else if (r.status === 404) {
          show("missing");
        } else if (r.status === 429) {
          fail("too many tries from this connection. wait a bit and try again.");
        } else {
          fail();
        }
      }).catch(function () { fail("check ur connection and try again."); });
    }

    $("[data-confirm-form]").addEventListener("submit", function (e) {
      e.preventDefault();
      var msg = $("[data-confirm-msg]");
      var input = $("[data-imei-input]");
      input.removeAttribute("aria-invalid");
      msg.textContent = "";
      if (!$("[data-confirm-box]").checked) { msg.textContent = "tick the box if everything above is right."; return; }
      var imei = (input.value || "").replace(/\D/g, "");
      if (view.imei && imei.length !== view.imei.digits) {
        input.setAttribute("aria-invalid", "true");
        msg.textContent = "enter the last " + view.imei.digits + " digits of the IMEI.";
        return;
      }
      var btn = $("[data-confirm-submit]");
      btn.disabled = true;
      api("confirm", { confirmed: true, imei: imei }).then(function (r) {
        if (r.status === 200 || r.status === 409 || r.status === 423) return render(r.data);
        if (r.status === 422 && r.data.error === "imei_mismatch") {
          input.setAttribute("aria-invalid", "true");
          input.value = "";
          msg.textContent = "those digits don't match the box. try again (" + r.data.tries_left + " " + (r.data.tries_left === 1 ? "try" : "tries") + " left).";
          return;
        }
        if (r.status === 400 && r.data.details) { msg.textContent = r.data.details[0].toLowerCase(); return; }
        if (r.status === 404) return show("missing");
        msg.textContent = r.status === 429 ? "too many tries. wait a bit and try again." : "couldn't check that just now. try again in a minute.";
      }).catch(function () {
        msg.textContent = "couldn't reach us. check ur connection and try again.";
      }).then(function () { btn.disabled = false; });
    });

    $("[data-wrong-open]").addEventListener("click", function () { $("[data-wrong-panel]").hidden = false; });
    $("[data-wrong-close]").addEventListener("click", function () { $("[data-wrong-panel]").hidden = true; });
    $("[data-wrong-send]").addEventListener("click", function () {
      var btn = this;
      btn.disabled = true;
      api("not_right").then(function (r) {
        if (r.status === 200 || r.status === 409) return render(r.data);
        fail("couldn't send that just now. call us instead.");
      }).catch(function () { fail("couldn't reach us. call us instead."); })
        .then(function () { btn.disabled = false; });
    });

    // New number: alongside a smartphone. Transfer: the dumbphone replaces it.
    // Gigs can't preselect either in Connect, so this only explains the
    // choice (the text is in the cards); Connect asks it again next.
    $$("[data-port]").forEach(function (b) {
      b.addEventListener("click", function () {
        $$("[data-port]").forEach(function (x) { x.setAttribute("aria-pressed", String(x === b)); });
      });
    });

    $("[data-activate]").addEventListener("click", function () {
      var btn = this;
      var msg = $("[data-activate-msg]");
      msg.textContent = "";
      btn.disabled = true;
      btn.textContent = "opening…";
      api("session").then(function (r) {
        // The url signs them in: go straight there, never keep it.
        if (r.status === 200 && r.data.url) return location.assign(r.data.url);
        btn.disabled = false;
        btn.textContent = "activate";
        if (r.status === 409 && r.data.error === "already_active") {
          show("activating");
          setTimeout(load, 5000);
          return;
        }
        if (r.status === 409 || r.status === 423) return render(r.data);
        if (r.status === 429) { msg.textContent = "one sec, then tap activate again."; return; }
        if (r.status === 404) return show("missing");
        msg.textContent = "couldn't start activation just now. try again in a minute.";
      }).catch(function () {
        btn.disabled = false;
        btn.textContent = "activate";
        msg.textContent = "couldn't reach us. check ur connection and try again.";
      });
    });

    $$("[data-porting-go]").forEach(function (b) {
      b.addEventListener("click", function () {
        var btn = this;
        btn.disabled = true;
        btn.textContent = "opening…";
        api("porting_session").then(function (r) {
          if (r.status === 200 && r.data.url) return location.assign(r.data.url);
          btn.disabled = false;
          btn.textContent = "finish";
          if (r.status === 409) return render(r.data);
          $("[data-porting-msg]").textContent = r.status === 429 ? "one sec, then try again." : "couldn't open that just now. try again in a minute.";
        }).catch(function () {
          btn.disabled = false;
          btn.textContent = "finish";
          $("[data-porting-msg]").textContent = "couldn't reach us. check ur connection and try again.";
        });
      });
    });

    $("[data-retry]").addEventListener("click", function () { polls = 0; show("loading"); load(); });

    support();
    if (!/^[A-Za-z0-9_-]{43}$/.test(token)) show("missing");
    else load();
  })();
  </script>
</body>
</html>
