---
/* any address that isn't a page */
import { A } from "../site/lib/assets";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>page not found - dumb.co</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/png" href={`${base}favicon.png`} />
  <style>
    body{margin:0; min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center;
         gap:18px; background:#F9F594; color:#111; font-family:"Helvetica Now Display", "Helvetica Neue", Helvetica, Arial, sans-serif; text-align:center; padding:24px;}
    img{width:200px; max-width:60vw;}
    h1{font-size:28px; margin:0;}
    a.home{display:inline-block; padding:12px 20px; border-radius:100px; background:#111; color:#F9F594; text-decoration:none; font-weight:700;}
  </style>
  <script is:inline define:vars={{ base }}>
    /* old addresses that moved, which can't be files of their own */
    var moved = { "faq/videos": "faq" };
    var here = location.pathname.slice(base.length).replace(/\/+$/, "");
    if (moved[here] !== undefined) location.replace(base + moved[here]);
    /* the quiz was public/mobile/index.html (served at /mobile/) until it
       became src/pages/mobile.astro (served at /mobile) */
    if (here === "mobile" && /\/$/.test(location.pathname)) location.replace(base + "mobile" + location.search);
    /* activation links (dumb.co/activate/<token>, emailed at delivery, and
       Gigs Connect's way back): one page serves every token, which it reads
       from the fragment -- so the token never reaches a server or a Referer */
    var act = /^activate\/([A-Za-z0-9_-]{43})$/.exec(here);
    if (act) location.replace(base + "activate" + location.search + "#" + act[1]);
  </script>
</head>
<body>
  <img src={A.logo} alt="dumb.co" />
  <h1>oops, that url is not valid :(</h1>
  <a class="home" href={base}>go back home</a>
</body>
</html>
