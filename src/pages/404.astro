---
/* any address that isn't a page */
import { A } from "../site/lib/assets";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>page not found - dumb.co</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/png" href={`${base}favicon.png`} />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;700&display=swap" />
  <style>
    body{margin:0; min-height:100vh; display:flex; flex-direction:column; align-items:center; justify-content:center;
         gap:18px; background:#F9F594; color:#111; font-family:Rubik, system-ui, sans-serif; text-align:center; padding:24px;}
    img{width:200px; max-width:60vw;}
    h1{font-size:28px; margin:0;}
    a.home{display:inline-block; padding:12px 20px; border-radius:100px; background:#111; color:#F9F594; text-decoration:none; font-weight:700;}
  </style>
  <script is:inline define:vars={{ base }}>
    /* old addresses that moved, which can't be files of their own */
    var moved = { "faq/videos": "faq" };
    var here = location.pathname.slice(base.length).replace(/\/+$/, "");
    if (moved[here] !== undefined) location.replace(base + moved[here]);
  </script>
</head>
<body>
  <img src={A.logo} alt="dumb.co" />
  <h1>oops, that url is not valid :(</h1>
  <a class="home" href={base}>go back home</a>
</body>
</html>
